# Copy to .env and fill in. .env is git-ignored.

# Tailscale auth key — create at https://login.tailscale.com/admin/settings/keys
# A reusable, pre-authorized key is convenient for rebuilds.
TS_AUTHKEY=

# Your laptop's SSH PUBLIC key, single line (e.g. `cat ~/.ssh/id_ed25519.pub`).
SSH_PUBKEY=

# Where all persistent state lives on the host (one tidy, git-ignored folder).
# On a Droplet you might set this to /opt/dbox/data.
DBOX_DATA=./data

# GitHub auth is done inside the box with `gh auth login` (paste a fine-grained
# PAT, or use web OAuth) — do NOT set GITHUB_TOKEN here; a token in the env
# makes `gh auth login` refuse to run.
