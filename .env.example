# Copy to .env and fill in
# cp .env.example .env

# Tailscale auth key — create at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=

# Your laptop's SSH PUBLIC key (e.g. `cat ~/.ssh/id_ed25519.pub`).
SSH_PUBKEY=

# Tailnet name for the box (MagicDNS). Defaults to "dbox". This is what you
# ssh to and what DBOX_HOST on the laptop targets.
DBOX_HOSTNAME=dbox

# Git commit identity, written into the box's ~/.gitconfig on each boot.
# Leave blank to skip. Change + restart to update (no rebuild needed).
GIT_USER_NAME=
GIT_USER_EMAIL=

# Where all persistent state lives on the host.
DBOX_DATA=./data
