#!/usr/bin/env bash
#
# dbox — local helper that wraps ssh/code to the remote dev box.
#
# Closed set of subcommands; arbitrary commands are forwarded only via
# `dbox exec`. Targets dev@${DBOX_HOST:-dbox} (short name resolves over
# Tailscale MagicDNS). See README for the raw ssh/tmux/code equivalents.

set -euo pipefail

HOST="${DBOX_HOST:-dbox}"
TARGET="dev@${HOST}"
WORKSPACE="/home/dev/workspace"   # absolute remote workspace root

usage() {
  cat <<EOF
dbox — make the remote dev box feel local (targets ${TARGET})

Usage:
  dbox                      open an interactive shell in ~/workspace
  dbox code [path]          open the remote path in VS Code (Remote-SSH)
  dbox terminal [path]      attach/create a per-project tmux session
                            (window 0: shell, window 1: claude)
  dbox exec <cmd...>        run a command on the box (≈ ssh dev@${HOST} ...)
  dbox ls                   list tmux sessions on the box
  dbox help                 show this help

Paths are relative to ~/workspace; a leading / or ~ is taken literally;
no path means ~/workspace. Override the host with DBOX_HOST=<name>.
EOF
}

# Resolve a user-supplied path arg to an ABSOLUTE remote path.
resolve_path() {
  local arg="${1:-}"
  case "$arg" in
    "")    printf '%s' "$WORKSPACE" ;;
    /*)    printf '%s' "$arg" ;;
    "~")   printf '/home/dev' ;;
    "~/"*) printf '/home/dev/%s' "${arg#\~/}" ;;
    *)     printf '%s/%s' "$WORKSPACE" "$arg" ;;
  esac
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
  ""|shell)
    exec ssh -t "$TARGET" 'cd ~/workspace; exec $SHELL -l'
    ;;

  code)
    if ! command -v code >/dev/null 2>&1; then
      echo "dbox: the 'code' CLI is not on PATH." >&2
      echo "      In VS Code: Cmd-Shift-P -> 'Shell Command: Install code command in PATH'." >&2
      exit 1
    fi
    # --folder-uri (not --remote <path>) so the folder reliably opens even when
    # a VS Code window is already focused on this remote.
    exec code --folder-uri "vscode-remote://ssh-remote+${TARGET}$(resolve_path "${1:-}")"
    ;;

  terminal)
    # Session layout lives in /usr/local/bin/dbox-session on the box, so this
    # CLI and the VS Code terminal profile share one implementation. The box
    # script resolves the path (relative to ~/workspace) and derives the name.
    exec ssh -t "$TARGET" dbox-session "${1:-}"
    ;;

  exec)
    [ $# -gt 0 ] || { echo "dbox: exec needs a command" >&2; usage >&2; exit 2; }
    tflag=()
    [ -t 1 ] && tflag=(-t)
    exec ssh "${tflag[@]}" "$TARGET" "$@"
    ;;

  ls)
    exec ssh "$TARGET" tmux ls
    ;;

  help|-h|--help)
    usage
    ;;

  *)
    echo "dbox: unknown command '$cmd'" >&2
    usage >&2
    exit 2
    ;;
esac
