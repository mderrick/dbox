#!/bin/sh
# dbox-session — attach to (or create) a per-project tmux session running Claude.
#
# Single source of truth for the session layout, shared by:
#   • the `dbox terminal` laptop CLI  ->  ssh -t dev@dbox dbox-session <path>
#   • the VS Code terminal profile    ->  exec dbox-session "$PWD"
#
# Layout: window 0 "shell" (fish), window 1 "claude" (launched with
# --remote-control "<session-name>" so the session is drivable from the Claude
# mobile app under a per-project name — remote-first is the whole point of
# running in this box). --continue resumes the most recent conversation in the
# project dir, so even after the claude process is gone (container restart) the
# rebuilt window picks up where it left off; on a brand-new dir it just starts
# fresh. Attaches focused on claude. Create-then-attach is idempotent, so
# reopening reattaches the live tmux session — which survives SSH drops (but not
# container restarts; the conversation does, via --continue).
set -eu

WORKSPACE="$HOME/workspace"

# --no-attach (-n): build/ensure the session but don't attach, then print its
# name. For callers that can't attach — Claude's non-interactive shell, or
# dbox-clone driving this headlessly. Default (no flag) attaches, as a human at
# `dbox terminal` / the VS Code profile expects.
no_attach=0
case "${1:-}" in
  -n|--no-attach) no_attach=1; shift ;;
esac

# Resolve the path arg to an absolute dir (mirrors `dbox` resolve_path):
#   ""  -> ~/workspace   /x -> literal   ~ -> $HOME   ~/x -> $HOME/x
#   x   -> ~/workspace/x
arg="${1:-}"
case "$arg" in
  "")    dir="$WORKSPACE" ;;
  /*)    dir="$arg" ;;
  "~")   dir="$HOME" ;;
  "~/"*) dir="$HOME/${arg#\~/}" ;;
  *)     dir="$WORKSPACE/$arg" ;;
esac

# Session name: path relative to ~/workspace when under it (acme/api ->
# acme-api), else the basename; sanitized (/, ., space -> -) for tmux.
case "$dir" in
  "$WORKSPACE"/*) rel="${dir#"$WORKSPACE"/}" ;;
  *)              rel="$(basename "$dir")" ;;
esac
name="$(printf '%s' "$rel" | tr './ ' '-')"
[ -n "$name" ] || name="workspace"

if ! tmux has-session -t "$name" 2>/dev/null; then
  tmux new-session -d -s "$name" -c "$dir" -n shell
fi
if ! tmux list-windows -t "$name" -F '#{window_name}' 2>/dev/null | grep -qx 'claude'; then
  tmux new-window -t "$name" -c "$dir" -n claude claude --remote-control "$name" --continue
fi
tmux select-window -t "$name":claude
if [ "$no_attach" -eq 1 ]; then
  printf '%s\n' "$name"
  exit 0
fi
exec tmux attach -t "$name"
